<!DOCTYPE html>
<html>
<head>
  <title>Projects-MyBasecamp</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">
  <h2><%= project ? "Edit the project" : "Create a new project" %></h2>

  <form 
    method="POST"
    action="<%= project ? '/project/' + project.id : '/project' %>"
  >
    <input type="text" name="title" placeholder="Layihə adı"
           value="<%= project?.title %>" required>

    <textarea name="description"
              placeholder="Açıqlama yaz..."><%= project?.description %></textarea>

    <button type="submit">Save</button>
  </form>

  <% if (project) { %>
    <form method="POST" action="/project/<%= project.id %>/delete">
      <button style="background:red;">Delete</button>
    </form>
  <% } %>

</div>

</body>
</html>